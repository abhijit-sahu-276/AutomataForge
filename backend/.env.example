# AutomataForge AI Configuration
# Supported providers: Gemini (default), OpenAI-compatible
# Note: Deterministic TOC algorithms work completely without any AI API key!

# Set your Gemini or OpenAI API key here
AI_API_KEY=your_gemini_api_key

# Model name:
# For Gemini: gemini-1.5-flash or gemini-2.0-flash or gemini-1.5-pro
# For OpenAI: gpt-4o-mini or gpt-4o
AI_MODEL=gemini-2.5-flash

# Provider type: "gemini" (default) or "openai"
AI_PROVIDER=gemini

# Optional custom base URL (e.g., https://generativelanguage.googleapis.com or https://api.openai.com/v1)
AI_BASE_URL=

